# Copy to .env and set real values. Never commit the filled file.
# Configure all OAuth values to enable login with an existing Wismail/mailcow mailbox.
WISMAIL_OAUTH_BASE_URL=https://mail.wiskind.top
WISMAIL_OAUTH_CLIENT_ID=
WISMAIL_OAUTH_CLIENT_SECRET=
WISMAIL_OAUTH_REDIRECT_URI=https://mail.wiskind.top/bulk/oauth/callback
WISMAIL_SESSION_SECRET=
WISMAIL_CREDENTIAL_KEY=
WISMAIL_URL_PREFIX=/bulk

# Legacy standalone admin login is used only when OAuth is not configured.
WISMAIL_ADMIN_USER=admin
WISMAIL_ADMIN_PASSWORD=
WISMAIL_BIND_HOST=127.0.0.1
WISMAIL_PORT=8765
WISMAIL_DB_PATH=./data/wismail.sqlite3

# Shared mail server addresses. Users authorize their own mailbox in the web UI.
# TLS is required (STARTTLS 587 or SSL 465).
WISMAIL_SMTP_HOST=mail.wiskind.top
WISMAIL_SMTP_PORT=587
# Legacy standalone sender only; not used for OAuth mailbox accounts.
WISMAIL_SMTP_USER=
WISMAIL_SMTP_PASSWORD=
WISMAIL_SMTP_FROM=

# Optional IMAP host for per-mailbox reply and bounce detection.
WISMAIL_IMAP_HOST=mail.wiskind.top
WISMAIL_IMAP_PORT=993
# Legacy standalone IMAP credentials only.
WISMAIL_IMAP_USER=
WISMAIL_IMAP_PASSWORD=

WISMAIL_DAILY_LIMIT=100
WISMAIL_MIN_INTERVAL_SECONDS=60
WISMAIL_UTC_OFFSET_HOURS=8
